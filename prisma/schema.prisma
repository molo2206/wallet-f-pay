  oauthaccesstoken oauthaccesstoken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "oauthrefreshtoken_ibfk_1")
  oauthclient      oauthclient      @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "oauthrefreshtoken_ibfk_2")
  user             user             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "oauthrefreshtoken_ibfk_3")

  @@index([accessTokenId], map: "accessTokenId")
  @@index([clientId], map: "clientId")
  @@index([expiresAt], map: "idx_oauth_refresh_token_expiresAt")
  @@index([userId], map: "idx_oauth_refresh_token_userId")
}

model fee_config {
  id                String                   @id @db.VarChar(36)
  countryId         String                   @db.VarChar(36)
  networkProviderId String?                  @db.VarChar(36)
  paymentMethod     fee_config_paymentMethod @default(CASH)
  feeType           fee_config_feeType       @default(FIXE)
  minAmount         Decimal?                 @db.Decimal(15, 2)
  maxAmount         Decimal?                 @db.Decimal(15, 2)
  feeAmount         Decimal?                 @db.Decimal(15, 2)
  feePercentage     Decimal?                 @db.Decimal(5, 2)
  flatFee           Decimal?                 @db.Decimal(15, 2)
  flatFeeCurrency   String?                  @default("FCFA") @db.VarChar(10)
  maxFee            Decimal?                 @db.Decimal(15, 2)
  minFee            Decimal?                 @db.Decimal(15, 2)
  isActive          Boolean                  @default(true)
  description       String?                  @db.Text
  createdBy         String?                  @db.VarChar(36)
  createdAt         DateTime                 @default(now()) @db.DateTime(0)
  updatedAt         DateTime                 @default(now()) @db.DateTime(0)
  updatedBy         String?                  @db.VarChar(36)
  country_provider  country_provider         @relation(fields: [countryId], references: [id], onDelete: Cascade, map: "fk_fee_config_country")
  network_provider  network_provider?        @relation(fields: [networkProviderId], references: [id], onDelete: Cascade, map: "fk_fee_config_network")

  @@unique([countryId, networkProviderId, paymentMethod, minAmount, maxAmount], map: "unique_fee_config")
  @@index([isActive], map: "idx_fee_config_active")
  @@index([countryId], map: "idx_fee_config_country")
  @@index([networkProviderId], map: "idx_fee_config_network")
  @@index([paymentMethod], map: "idx_fee_config_payment_method")
}

