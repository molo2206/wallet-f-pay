model oauthrefreshtoken {
  id               String           @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  token            String           @unique(map: "token") @db.VarChar(500)
  accessTokenId    String           @db.VarChar(36)
  clientId         String           @db.VarChar(36)
  userId           String           @db.VarChar(36)
