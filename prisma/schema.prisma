  reason                                          String?     @db.Text
  metadata                                        String?     @db.LongText
  reconciled_by                                   String?     @db.VarChar(36)
  reconciled_at                                   DateTime    @default(now()) @db.DateTime(0)
  created_at                                      DateTime    @default(now()) @db.DateTime(0)
  updated_at                                      DateTime    @default(now()) @db.DateTime(0)
  user_reconciliation_history_reconciled_byTouser user?       @relation("reconciliation_history_reconciled_byTouser", fields: [reconciled_by], references: [id], onUpdate: Restrict, map: "fk_rec_reconciled_by")
  transaction                                     transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rec_trans")
  user_reconciliation_history_user_idTouser       user        @relation("reconciliation_history_user_idTouser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rec_user")
  wallet                                          wallet      @relation(fields: [wallet_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rec_wallet")

  @@index([reconciled_at], map: "idx_reconciled_at")
  @@index([reconciled_by], map: "idx_reconciled_by")
  @@index([reconciliation_type], map: "idx_reconciliation_type")
  @@index([reference], map: "idx_reference")
  @@index([old_status, new_status], map: "idx_status")
  @@index([transaction_id], map: "idx_transaction_id")
  @@index([user_id], map: "idx_user_id")
  @@index([wallet_id], map: "idx_wallet_id")
}

model oauthaccesstoken {
