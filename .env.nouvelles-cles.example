# ===== Nouvelles clés (audit F-Pay, novembre 2026) — à AJOUTER au .env du serveur, toutes facultatives =====

# --- Sessions ---
# true (défaut) : une session fermée / expirée / remplacée est réellement refusée (correctif de validate_session)
# false : ancien comportement (secours uniquement, en cas de problème de déploiement)
SESSION_STRICT=true

# --- Programmes de travail ---
WORK_SCHEDULE_ENABLED=true
# Rôles jamais limités par un programme (séparés par des virgules)
WORK_SCHEDULE_EXEMPT_ROLES=SUPER_ADMIN
# Fuseau par défaut si general_settings.timezone est vide
WORK_SCHEDULE_DEFAULT_TIMEZONE=Africa/Lubumbashi
# Cache de la décision par utilisateur (s) — toujours borné par l'heure de fin exacte
WORK_SCHEDULE_CACHE_SECONDS=30
# Supprimer aussi les jetons OAuth de l'utilisateur à la fin de ses horaires
WORK_SCHEDULE_REVOKE_OAUTH=true
WORK_SCHEDULE_EXCEPTION_MAX_DAYS=31

# --- Idempotence (api-gateway) ---
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_AUTO_WINDOW_SECONDS=30
IDEMPOTENCY_KEY_TTL_HOURS=24
IDEMPOTENCY_PROCESSING_TTL_SECONDS=180
IDEMPOTENCY_UNCERTAIN_LOCK_MINUTES=10

# --- api/external/pay/mobile_money ---
# true : externalReference (ou depositId) obligatoire ; un même dépôt n'est jamais crédité deux fois
PAY_ACCOUNT_REQUIRE_REFERENCE=false

# --- Montants à 3 décimales ---
MONEY_ROUNDING_ENABLED=true
# true : ajoute "<champ>Formatted": "10.000" dans les réponses (sinon via l'en-tête X-Money-Format: 3)
MONEY_FORMATTED_FIELDS=false
# true : refuse (400) un montant saisi avec plus de 3 décimales ; false : l'arrondit à 3 décimales
MONEY_INPUT_STRICT=false

# --- Journal Prisma (performance) : query,info,warn,error pour diagnostiquer ---
PRISMA_LOG=warn,error

# --- Routes de consultation historiquement publiques (users/:id, wallet/transactions/:id) ---
# true : jeton obligatoire et accès limité au propriétaire (activer après mise à jour des applications)
PUBLIC_LOOKUP_PROTECTION=false

# --- Double validation des recharges admin ---
# off | no_counterpart (défaut : SUPER_ADMIN sur un wallet sans agence) | threshold | all
ADMIN_APPROVAL_MODE=no_counterpart
# Seuils (mode threshold), par devise
ADMIN_APPROVAL_THRESHOLDS=USD:500,CDF:1500000
ADMIN_APPROVAL_TTL_HOURS=24
# true seulement s'il n'y a qu'un seul SUPER_ADMIN (il pourra valider sa propre demande)
ADMIN_APPROVAL_ALLOW_SELF=false

# --- Plafonds par niveau KYC ---
# off | monitor (défaut : dépassements journalisés, rien n'est bloqué) | enforce
LIMITS_MODE=monitor
LIMITS_REFERENCE_CURRENCY=USD
LIMITS_EXEMPT_ROLES=ADMIN,SUPER_ADMIN
# true : user_transaction_limit remplace le niveau KYC (vérifiez d'abord ces lignes, beaucoup ont été créées avec des valeurs par défaut)
LIMITS_USE_USER_OVERRIDES=false

# --- Grand livre ---
LEDGER_ENABLED=true
LEDGER_BATCH=500

# --- Trésorerie ---
PAWAPAY_FLOAT_FROM_API=true
# Alerte quand le float PawaPay passe sous le seuil
FLOAT_ALERT_THRESHOLDS=CDF:5000000,USD:2000
COVERAGE_DAILY_ENABLED=true

# --- Mode maintenance ---
MAINTENANCE_ENABLED=true
# Rôles exemptés par défaut (personnalisable par fenêtre)
MAINTENANCE_EXEMPT_ROLES=SUPER_ADMIN,ADMIN
# IP de l'équipe technique toujours autorisées (séparées par des virgules)
MAINTENANCE_ALLOW_IPS=
MAINTENANCE_CACHE_SECONDS=10
# Synchroniser app_settings.maintenance_mode pour les applications qui le lisent déjà
MAINTENANCE_SYNC_APP_SETTINGS=true
MAINTENANCE_NOTIFY_MAX_USERS=50000
